{
  "baseUrl": "http://localhost:8080/api/auth",
  "endpoints": [
    {
      "id": "AUTH_001",
      "name": "User Login",
      "method": "POST",
      "endpoint": "/api/auth/login",
      "description": "Authenticate user with email and password. Returns JWT token and user details.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "example": "user@example.com",
              "required": true
            },
            "password": {
              "type": "string",
              "example": "password123",
              "required": true
            }
          }
        },
        "example": {
          "email": "student@thirutech.com",
          "password": "securePassword123"
        }
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "description": "JWT authentication token"
            },
            "email": {
              "type": "string",
              "description": "User email address"
            },
            "role": {
              "type": "string",
              "enum": ["STUDENT", "TRAINER", "ADMIN"],
              "description": "User role"
            },
            "message": {
              "type": "string",
              "description": "Success message"
            }
          }
        },
        "example": {
          "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "email": "student@thirutech.com",
          "role": "STUDENT",
          "message": "Login successful"
        }
      },
      "errors": [
        {
          "statusCode": 401,
          "description": "Invalid email or password"
        },
        {
          "statusCode": 400,
          "description": "Bad request - missing required fields"
        }
      ]
    },
    {
      "id": "AUTH_002",
      "name": "User Registration",
      "method": "POST",
      "endpoint": "/api/auth/register",
      "description": "Register a new user account. Returns JWT token for newly created user.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "example": "John Doe",
              "required": true
            },
            "email": {
              "type": "string",
              "example": "john@example.com",
              "required": true
            },
            "password": {
              "type": "string",
              "example": "password123",
              "required": true
            },
            "phone": {
              "type": "string",
              "example": "9876543210",
              "required": true
            },
            "role": {
              "type": "string",
              "enum": ["STUDENT", "TRAINER", "ADMIN"],
              "example": "STUDENT",
              "required": true
            },
            "status": {
              "type": "boolean",
              "example": true,
              "required": false
            }
          }
        },
        "example": {
          "fullName": "Raj Kumar",
          "email": "raj@thirutech.com",
          "password": "SecurePass123",
          "phone": "9876543210",
          "role": "STUDENT",
          "status": true
        }
      },
      "response": {
        "statusCode": 201,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "description": "JWT authentication token"
            },
            "email": {
              "type": "string",
              "description": "User email address"
            },
            "role": {
              "type": "string",
              "description": "User role"
            },
            "message": {
              "type": "string",
              "description": "Success message"
            }
          }
        },
        "example": {
          "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "email": "raj@thirutech.com",
          "role": "STUDENT",
          "message": "Registration successful"
        }
      },
      "errors": [
        {
          "statusCode": 409,
          "description": "Email already exists"
        },
        {
          "statusCode": 400,
          "description": "Bad request - missing required fields"
        }
      ]
    }
  ]
}
