{
  "baseUrl": "http://localhost:8080/api/dashboard",
  "endpoints": [
    {
      "id": "DASHBOARD_001",
      "name": "Get Dashboard Statistics",
      "method": "GET",
      "endpoint": "/api/dashboard/stats",
      "description": "Retrieve comprehensive dashboard statistics including student count, courses, batches, trainers, revenue, and payments.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "totalStudents": {
              "type": "integer",
              "description": "Total number of students in the system"
            },
            "activeStudents": {
              "type": "integer",
              "description": "Number of active students"
            },
            "totalCourses": {
              "type": "integer",
              "description": "Total number of courses available"
            },
            "totalBatches": {
              "type": "integer",
              "description": "Total number of batches created"
            },
            "ongoingBatches": {
              "type": "integer",
              "description": "Number of batches currently ongoing"
            },
            "totalTrainers": {
              "type": "integer",
              "description": "Total number of trainers"
            },
            "totalRevenue": {
              "type": "number",
              "format": "decimal",
              "description": "Total revenue from all payments"
            },
            "totalPayments": {
              "type": "integer",
              "description": "Total number of payments received"
            }
          }
        },
        "example": {
          "totalStudents": 150,
          "activeStudents": 120,
          "totalCourses": 8,
          "totalBatches": 12,
          "ongoingBatches": 5,
          "totalTrainers": 6,
          "totalRevenue": 500000.00,
          "totalPayments": 75
        }
      }
    }
  ]
}
