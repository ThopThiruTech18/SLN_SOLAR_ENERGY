{
  "baseUrl": "http://localhost:8080/api/attendance",
  "endpoints": [
    {
      "id": "ATTENDANCE_001",
      "name": "Get All Attendance Records",
      "method": "GET",
      "endpoint": "/api/attendance",
      "description": "Retrieve all attendance records.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "ATTENDANCE_002",
      "name": "Get Attendance by Student",
      "method": "GET",
      "endpoint": "/api/attendance/student/{studentId}",
      "description": "Retrieve all attendance records for a specific student.",
      "pathParameters": [
        {
          "name": "studentId",
          "type": "integer",
          "required": true,
          "description": "Student ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array"
        }
      }
    },
    {
      "id": "ATTENDANCE_003",
      "name": "Mark Attendance",
      "method": "POST",
      "endpoint": "/api/attendance",
      "description": "Mark attendance for a student in a batch on a specific date.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "studentId": {
              "type": "integer",
              "example": 10,
              "required": true
            },
            "batchId": {
              "type": "integer",
              "example": 10,
              "required": true
            },
            "attendanceDate": {
              "type": "string",
              "format": "date",
              "example": "2024-02-01",
              "required": true
            },
            "status": {
              "type": "string",
              "enum": ["PRESENT", "ABSENT", "LEAVE"],
              "example": "PRESENT",
              "required": true
            }
          }
        },
        "example": {
          "studentId": 10,
          "batchId": 10,
          "attendanceDate": "2024-02-01",
          "status": "PRESENT"
        }
      },
      "response": {
        "statusCode": 201,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "attendanceId": {
              "type": "integer"
            },
            "studentName": {
              "type": "string"
            },
            "batchName": {
              "type": "string"
            },
            "attendanceDate": {
              "type": "string",
              "format": "date"
            },
            "status": {
              "type": "string"
            }
          }
        },
        "example": {
          "attendanceId": 100,
          "studentName": "Raj Kumar",
          "batchName": "Java Advanced Batch 2024",
          "attendanceDate": "2024-02-01",
          "status": "PRESENT"
        }
      },
      "errors": [
        {
          "statusCode": 404,
          "description": "Student or Batch not found"
        },
        {
          "statusCode": 400,
          "description": "Bad request - missing required fields"
        }
      ]
    },
    {
      "id": "ATTENDANCE_004",
      "name": "Delete Attendance Record",
      "method": "DELETE",
      "endpoint": "/api/attendance/{id}",
      "description": "Delete an attendance record.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "Attendance ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 204,
        "description": "No content - Attendance record deleted successfully"
      }
    }
  ]
}
