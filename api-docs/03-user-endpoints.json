{
  "baseUrl": "http://localhost:8080/api/users",
  "endpoints": [
    {
      "id": "USER_001",
      "name": "Create User",
      "method": "POST",
      "endpoint": "/api/users",
      "description": "Create a new user account.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string",
              "example": "John Doe",
              "required": true
            },
            "email": {
              "type": "string",
              "example": "john@example.com",
              "required": true
            },
            "password": {
              "type": "string",
              "example": "password123",
              "required": true
            },
            "phone": {
              "type": "string",
              "example": "9876543210",
              "required": false
            },
            "role": {
              "type": "string",
              "enum": ["STUDENT", "TRAINER", "ADMIN"],
              "example": "STUDENT",
              "required": true
            },
            "status": {
              "type": "boolean",
              "example": true,
              "required": false
            }
          }
        },
        "example": {
          "fullName": "Amit Sharma",
          "email": "amit@thirutech.com",
          "password": "SecurePass123",
          "phone": "9876543210",
          "role": "TRAINER",
          "status": true
        }
      },
      "response": {
        "statusCode": 201,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "userId": {
              "type": "integer"
            },
            "fullName": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "status": {
              "type": "boolean"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "example": {
          "userId": 20,
          "fullName": "Amit Sharma",
          "email": "amit@thirutech.com",
          "phone": "9876543210",
          "role": "TRAINER",
          "status": true,
          "createdAt": "2024-01-15T10:30:00"
        }
      }
    },
    {
      "id": "USER_002",
      "name": "Update User",
      "method": "PUT",
      "endpoint": "/api/users/{id}",
      "description": "Update an existing user account.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "User ID"
        }
      ],
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "fullName": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "phone": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "status": {
              "type": "boolean"
            }
          }
        },
        "example": {
          "phone": "9876543211",
          "status": true
        }
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json"
      }
    },
    {
      "id": "USER_003",
      "name": "Get User by ID",
      "method": "GET",
      "endpoint": "/api/users/{id}",
      "description": "Retrieve details of a specific user.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "User ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "example": {
          "userId": 20,
          "fullName": "Amit Sharma",
          "email": "amit@thirutech.com",
          "phone": "9876543210",
          "role": "TRAINER",
          "status": true,
          "createdAt": "2024-01-15T10:30:00"
        }
      }
    },
    {
      "id": "USER_004",
      "name": "Get All Users",
      "method": "GET",
      "endpoint": "/api/users",
      "description": "Retrieve list of all users.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array"
        }
      }
    },
    {
      "id": "USER_005",
      "name": "Get Active Users",
      "method": "GET",
      "endpoint": "/api/users/active",
      "description": "Retrieve list of all active users.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array"
        }
      }
    },
    {
      "id": "USER_006",
      "name": "Delete User",
      "method": "DELETE",
      "endpoint": "/api/users/{id}",
      "description": "Delete a user account.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "User ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 204,
        "description": "No content - User deleted successfully"
      }
    }
  ]
}
