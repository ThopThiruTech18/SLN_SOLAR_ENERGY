{
  "baseUrl": "http://localhost:8080/api/enrollments",
  "endpoints": [
    {
      "id": "ENROLLMENT_001",
      "name": "Enroll Student in Batch",
      "method": "POST",
      "endpoint": "/api/enrollments",
      "description": "Enroll a student in a batch. Can lookup student by studentId or email. Auto-creates student record if needed.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "studentId": {
              "type": "integer",
              "example": 10,
              "required": false,
              "description": "ID of the student (optional, can use email instead)"
            },
            "batchId": {
              "type": "integer",
              "example": 10,
              "required": true,
              "description": "ID of the batch to enroll in"
            },
            "enrollmentDate": {
              "type": "string",
              "format": "date",
              "example": "2024-02-01",
              "required": false
            },
            "email": {
              "type": "string",
              "example": "student@example.com",
              "required": false,
              "description": "Email for student lookup (fallback if studentId not provided)"
            }
          }
        },
        "example": {
          "studentId": 10,
          "batchId": 10,
          "enrollmentDate": "2024-02-01"
        }
      },
      "response": {
        "statusCode": 201,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "studentId": {
              "type": "integer"
            },
            "batchId": {
              "type": "integer"
            },
            "batchName": {
              "type": "string"
            },
            "enrollmentDate": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "example": {
          "message": "Enrollment successful!",
          "studentId": 10,
          "batchId": 10,
          "batchName": "Java Advanced Batch 2024",
          "enrollmentDate": "2024-02-01"
        }
      },
      "errors": [
        {
          "statusCode": 404,
          "description": "Student or Batch not found"
        },
        {
          "statusCode": 409,
          "description": "Student already enrolled in this batch"
        }
      ]
    },
    {
      "id": "ENROLLMENT_002",
      "name": "Get Enrollments by Student",
      "method": "GET",
      "endpoint": "/api/enrollments/student/{studentId}",
      "description": "Retrieve all batch enrollments for a specific student.",
      "pathParameters": [
        {
          "name": "studentId",
          "type": "integer",
          "required": true,
          "description": "Student ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "example": [
          {
            "enrollmentId": 1,
            "enrollmentDate": "2024-02-01",
            "batchId": 10,
            "batchName": "Java Advanced Batch 2024",
            "startDate": "2024-02-01",
            "endDate": "2024-05-01",
            "schedule": "Monday to Friday, 10:00 AM - 1:00 PM",
            "status": "ACTIVE",
            "courseName": "Advanced Java Programming",
            "trainerName": "Amit Sharma"
          },
          {
            "enrollmentId": 2,
            "enrollmentDate": "2024-03-15",
            "batchId": 11,
            "batchName": "Python Batch 2024",
            "startDate": "2024-03-15",
            "endDate": "2024-05-15",
            "schedule": "Tuesday and Thursday, 6:00 PM - 8:00 PM",
            "status": "ACTIVE",
            "courseName": "Python Programming",
            "trainerName": "Priya Singh"
          }
        ]
      }
    }
  ]
}
