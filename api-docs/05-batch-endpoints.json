{
  "baseUrl": "http://localhost:8080/api/batches",
  "endpoints": [
    {
      "id": "BATCH_001",
      "name": "Create Batch",
      "method": "POST",
      "endpoint": "/api/batches",
      "description": "Create a new batch for a course with a trainer.",
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "batchName": {
              "type": "string",
              "example": "Java Batch 001",
              "required": true
            },
            "courseId": {
              "type": "integer",
              "example": 1,
              "required": true,
              "description": "ID of the course"
            },
            "trainerId": {
              "type": "integer",
              "example": 5,
              "required": true,
              "description": "ID of the trainer"
            },
            "startDate": {
              "type": "string",
              "format": "date",
              "example": "2024-02-01",
              "required": true
            },
            "endDate": {
              "type": "string",
              "format": "date",
              "example": "2024-05-01",
              "required": true
            },
            "schedule": {
              "type": "string",
              "example": "Monday to Friday, 10:00 AM - 1:00 PM",
              "required": false
            },
            "status": {
              "type": "string",
              "enum": ["ACTIVE", "INACTIVE", "COMPLETED"],
              "example": "ACTIVE",
              "required": false
            }
          }
        },
        "example": {
          "batchName": "Java Advanced Batch 2024",
          "courseId": 1,
          "trainerId": 5,
          "startDate": "2024-02-01",
          "endDate": "2024-05-01",
          "schedule": "Monday to Friday, 10:00 AM - 1:00 PM",
          "status": "ACTIVE"
        }
      },
      "response": {
        "statusCode": 201,
        "contentType": "application/json",
        "body": {
          "type": "object",
          "properties": {
            "batchId": {
              "type": "integer"
            },
            "batchName": {
              "type": "string"
            },
            "courseName": {
              "type": "string"
            },
            "trainerName": {
              "type": "string"
            },
            "startDate": {
              "type": "string",
              "format": "date"
            },
            "endDate": {
              "type": "string",
              "format": "date"
            },
            "schedule": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "enrolledStudents": {
              "type": "integer"
            }
          }
        },
        "example": {
          "batchId": 10,
          "batchName": "Java Advanced Batch 2024",
          "courseName": "Advanced Java Programming",
          "trainerName": "Amit Sharma",
          "startDate": "2024-02-01",
          "endDate": "2024-05-01",
          "schedule": "Monday to Friday, 10:00 AM - 1:00 PM",
          "status": "ACTIVE",
          "enrolledStudents": 0
        }
      }
    },
    {
      "id": "BATCH_002",
      "name": "Update Batch",
      "method": "PUT",
      "endpoint": "/api/batches/{id}",
      "description": "Update an existing batch.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "Batch ID"
        }
      ],
      "request": {
        "contentType": "application/json",
        "body": {
          "type": "object"
        }
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json"
      }
    },
    {
      "id": "BATCH_003",
      "name": "Get Batch by ID",
      "method": "GET",
      "endpoint": "/api/batches/{id}",
      "description": "Retrieve details of a specific batch.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "Batch ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json"
      }
    },
    {
      "id": "BATCH_004",
      "name": "Get All Batches",
      "method": "GET",
      "endpoint": "/api/batches",
      "description": "Retrieve list of all batches.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array"
        }
      }
    },
    {
      "id": "BATCH_005",
      "name": "Get Ongoing Batches",
      "method": "GET",
      "endpoint": "/api/batches/ongoing",
      "description": "Retrieve list of all ongoing batches.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array"
        }
      }
    },
    {
      "id": "BATCH_006",
      "name": "Get Active Batches",
      "method": "GET",
      "endpoint": "/api/batches/active",
      "description": "Retrieve list of all active batches.",
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 200,
        "contentType": "application/json",
        "body": {
          "type": "array"
        }
      }
    },
    {
      "id": "BATCH_007",
      "name": "Delete Batch",
      "method": "DELETE",
      "endpoint": "/api/batches/{id}",
      "description": "Delete a batch.",
      "pathParameters": [
        {
          "name": "id",
          "type": "integer",
          "required": true,
          "description": "Batch ID"
        }
      ],
      "request": {
        "description": "No request body required"
      },
      "response": {
        "statusCode": 204,
        "description": "No content - Batch deleted successfully"
      }
    }
  ]
}
